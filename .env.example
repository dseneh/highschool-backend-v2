# Copy to .env and fill in values for local development.

DEBUG=True
SECRET_KEY=local-dev-secret

# Browser security headers returned by the backend API.
SECURE_REFERRER_POLICY=no-referrer
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
API_CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# --- Local email (Gmail) ---
# Use a Google App Password: https://myaccount.google.com/apppasswords
# Leave RESEND_API_KEY empty so local mail uses SMTP, not Resend.
RESEND_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=you@gmail.com
EMAIL_FROM_NAME=EzySchool

# Privileged login email MFA (platform admins, tenant admins, finance/payroll approvers)
EMAIL_MFA_PRIVILEGED_ENABLED=False
EMAIL_MFA_CODE_TTL_SECONDS=600
EMAIL_MFA_MAX_ATTEMPTS=5
EMAIL_MFA_RESEND_COOLDOWN_SECONDS=60
EMAIL_MFA_MAX_RESENDS=5
API_THROTTLE_MFA_VERIFY=10/min
API_THROTTLE_MFA_RESEND=5/hour
API_THROTTLE_STEP_UP_START=60/hour
API_THROTTLE_STEP_UP_VERIFY=30/min
API_THROTTLE_MFA_RECOVERY=30/hour
API_THROTTLE_PASSWORD_RESET=30/hour
PASSWORD_RESET_ACCOUNT_LIMIT_PER_HOUR=3
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
MFA_RECOVERY_ACCOUNT_LIMIT_PER_HOUR=3
MFA_RECOVERY_REQUEST_COOLDOWN_SECONDS=60
JWT_REFRESH_TOKEN_LIFETIME=30
SSO_SESSION_LIFETIME_DAYS=30

# Where signup-request admin alerts are delivered locally
ADMIN_NOTIFICATION_EMAIL=you@gmail.com
SUPPORT_EMAIL=you@gmail.com

# --- Optional S3/R2 storage ---
USE_S3_STORAGE=False
# R2_BUCKET=ezyschool-media
# R2_ACCESS_KEY_ID=<your-r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_CUSTOM_DOMAIN=<your-custom-domain-for-media>

# --- Tenant backup service ---
TENANT_BACKUP_TIMEOUT_SECONDS=1800
TENANT_BACKUP_STALE_MINUTES=90
TENANT_BACKUP_SCHEDULE_ENABLED=False
TENANT_BACKUP_SCHEDULE_INTERVAL_HOURS=168
TENANT_BACKUP_RETENTION_MANUAL_DAYS=30
TENANT_BACKUP_RETENTION_SCHEDULED_DAYS=30
TENANT_BACKUP_RETENTION_PRE_RESTORE_DAYS=90
TENANT_BACKUP_RETENTION_SYSTEM_DAYS=30
# Optional dedicated private R2 backup bucket/credentials. If omitted, the
# configured media R2 credentials are reused with a separate storage alias.
# R2_BACKUP_BUCKET=ezyschool-backups
# R2_BACKUP_ACCESS_KEY_ID=<backup-access-key-id>
# R2_BACKUP_SECRET_ACCESS_KEY=<backup-secret-access-key>
# R2_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# TENANT_BACKUP_SCHEDULE_ENABLED=True
# TENANT_BACKUP_SCHEDULE_INTERVAL_HOURS=24
# TENANT_BACKUP_RETENTION_MANUAL_DAYS=30
# TENANT_BACKUP_RETENTION_SCHEDULED_DAYS=30
# TENANT_BACKUP_RETENTION_PRE_RESTORE_DAYS=90
# TENANT_BACKUP_RETENTION_SYSTEM_DAYS=30
# TENANT_BACKUP_POLL_SECONDS=10
# TENANT_RESTORE_POLL_SECONDS=10

# Accounting attachment upload policy (server-side)
ACCOUNTING_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ACCOUNTING_ATTACHMENT_UPLOAD_PREFIX=accounting/attachments
