{
  "module": "backups",
  "label": "Backups & Recovery",
  "description": "Tenant backup history and controlled restore requests",
  "permissions": [
    {"code": "backups.view", "name": "View Backups", "risk": "high", "scopes": ["all"]},
    {"code": "backups.create", "name": "Create Backup", "risk": "critical", "scopes": ["all"], "requires": ["backups.view"]},
    {"code": "backups.delete", "name": "Delete Backup", "risk": "critical", "scopes": ["all"], "requires": ["backups.view"]},
    {"code": "restore.request", "name": "Request Restore", "risk": "critical", "scopes": ["all"], "requires": ["backups.view"]},
    {"code": "restore.execute", "name": "Execute Restore", "risk": "critical", "scopes": ["all"], "requires": ["backups.view", "restore.request"]}
  ]
}

